# Copy this file to ".env" (exactly that name) and fill in your values. NEVER commit .env to GitHub.

# PostgreSQL. Local example:
DATABASE_URL=postgres://shushop:shushop@localhost:5432/shushop

# Hosted example (Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler"):
# DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Hosted databases use their own certificate authority. Supabase's is bundled in certs/supabase-ca.crt and used
# automatically for *.supabase.com / *.supabase.co. For another provider, paste its CA certificate (PEM text) here,
# or put a file path in DB_SSL_CA_FILE:
# DB_SSL_CA=
# DB_SSL_CA_FILE=

PORT=3000
